# Environment variables for the app on AWS. There are no database secrets: the app reaches DynamoDB
# and S3 through its IAM role.

CD_DYNAMODB_TABLE=cd-main
CD_DYNAMODB_REGION=ap-south-1

CD_ENV=prod
CD_API_ADDR=:8080
CD_LOG_LEVEL=info
CD_DEMO_SEED=false
# The ALB sets X-Forwarded-For; rate limits use the real client IP.
CD_TRUST_PROXY=true
CD_RATE_LIMIT=true

# Use the same HTTPS origin when the Go API serves the built PWA.
CD_PUBLIC_API_URL=https://app.your-domain.example
CD_PUBLIC_WEB_URL=https://app.your-domain.example
CD_WEB_ORIGINS=https://app.your-domain.example

# AWS S3 storage. Leave endpoint blank for native AWS S3.
# On ECS, prefer an IAM task role and leave access/secret keys unset.
CD_STORAGE_ENDPOINT=
CD_STORAGE_REGION=ap-south-1
CD_STORAGE_BUCKET=counter-drop-prod-files
CD_STORAGE_ACCESS_KEY=
CD_STORAGE_SECRET_KEY=

CD_UNDO_WINDOW=10m
CD_ABANDON_AFTER=60m
CD_DELETION_INTERVAL=30s
CD_MAX_FILE_MB=500
CD_MAX_JOB_MB=500
CD_MAX_FILES=20
CD_SESSION_TTL=12h
CD_SETUP_LINK_TTL=48h
