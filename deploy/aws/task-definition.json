{
  "family": "counter-drop-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/counter-drop-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/counter-drop-app-task-role",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<account-id>.dkr.ecr.<region>.amazonaws.com/counter-drop:<image-tag>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "CD_ENV", "value": "prod" },
        { "name": "CD_API_ADDR", "value": ":8080" },
        { "name": "CD_LOG_LEVEL", "value": "info" },
        { "name": "CD_DEMO_SEED", "value": "false" },
        { "name": "CD_TRUST_PROXY", "value": "true" },
        { "name": "CD_RATE_LIMIT", "value": "true" },
        { "name": "CD_PUBLIC_API_URL", "value": "https://app.your-domain.example" },
        { "name": "CD_PUBLIC_WEB_URL", "value": "https://app.your-domain.example" },
        { "name": "CD_WEB_ORIGINS", "value": "https://app.your-domain.example" },
        { "name": "CD_DYNAMODB_TABLE", "value": "cd-main" },
        { "name": "CD_DYNAMODB_REGION", "value": "ap-south-1" },
        { "name": "CD_STORAGE_REGION", "value": "ap-south-1" },
        { "name": "CD_STORAGE_BUCKET", "value": "counter-drop-prod-files" },
        { "name": "CD_UNDO_WINDOW", "value": "10m" },
        { "name": "CD_ABANDON_AFTER", "value": "60m" },
        { "name": "CD_DELETION_INTERVAL", "value": "30s" },
        { "name": "CD_MAX_FILE_MB", "value": "500" },
        { "name": "CD_MAX_JOB_MB", "value": "500" },
        { "name": "CD_MAX_FILES", "value": "20" },
        { "name": "CD_SESSION_TTL", "value": "12h" },
        { "name": "CD_SETUP_LINK_TTL", "value": "48h" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/ready >/dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/counter-drop-prod",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
