# Copy to deploy/prod.env and fill before a VM/docker-compose deploy (fallback to Lambda, ADR-001).
# Never commit deploy/prod.env.

# Data: the DynamoDB table (create once with: cdadmin create-table). Use an IAM user whose policy allows
# only this table and the files bucket (see deploy/aws/app-task-role-policy.json).
CD_DYNAMODB_TABLE=cd-main
CD_DYNAMODB_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# HTTPS with the bundled Caddy (--profile https): your domain (DNS A record → this server) and an
# email for Let's Encrypt expiry notices.
CD_DOMAIN=your-domain.example
ACME_EMAIL=you@your-domain.example

# Shown on /privacy and /terms (baked into the web build). Use the legal operator name and a real inbox.
VITE_OPERATOR_NAME=Your Company Name
VITE_SUPPORT_EMAIL=support@your-domain.example

CD_ENV=prod
CD_API_ADDR=:8080
CD_LOG_LEVEL=info
CD_PUBLIC_API_URL=https://your-domain.example
CD_PUBLIC_WEB_URL=https://your-domain.example
CD_WEB_ORIGINS=https://your-domain.example
CD_DEMO_SEED=false
# Behind Caddy (or any proxy that sets X-Forwarded-For) so rate limits see the real client IP.
CD_TRUST_PROXY=true
CD_RATE_LIMIT=true

# If you keep files on the VM, mount /data/files and set a stable random signing key.
# Generate: openssl rand -hex 32
CD_STORAGE_DIR=/data/files
CD_STORAGE_SIGNING_KEY=change-me-64-hex-random

# Prefer R2/S3 for a safer pilot. Set all of these to switch away from local disk.
CD_STORAGE_ENDPOINT=
CD_STORAGE_REGION=auto
CD_STORAGE_BUCKET=
CD_STORAGE_ACCESS_KEY=
CD_STORAGE_SECRET_KEY=

CD_UNDO_WINDOW=10m
CD_ABANDON_AFTER=60m
CD_DELETION_INTERVAL=30s
CD_MAX_FILE_MB=500
CD_MAX_JOB_MB=500
CD_MAX_FILES=20
CD_SESSION_TTL=12h
CD_SETUP_LINK_TTL=48h
